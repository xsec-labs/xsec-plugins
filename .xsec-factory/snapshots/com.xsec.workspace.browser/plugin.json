{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "com.xsec.workspace.browser",
  "version": "3.1.0",
  "description": "XSEC browser session MCP, runtime, and workspace tool",
  "author": {
    "name": "XSEC"
  },
  "license": "MIT",
  "extensions": {
    "com.xsec.desktop": {
